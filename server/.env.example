# ─── Server ──────────────────────────────────────────────────────────────────
# Render injects PORT automatically. Keep this fallback for local dev.
PORT=5000
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_IN=24h

# ─── CORS / Client URLs ──────────────────────────────────────────────────────
CLIENT_URL=https://alexjersey.rocks
ADMIN_URL=https://admin.alexjersey.rocks

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Admin seed account ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@alexjersey.rocks
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_USERNAME=Admin
ADMIN_PHONE=9800000000

# ─── WhatsApp wa.me link (for order confirmation URLs) ───────────────────────
WHATSAPP_BUSINESS_NUMBER=9779800000000

# ─── WAHA (self-hosted WhatsApp HTTP API) ────────────────────────────────────
#
# CRITICAL for production on Render:
#   WAHA_URL must be the EXTERNAL URL of your deployed WAHA service.
#   Do NOT use http://localhost:3000 or http://127.0.0.1:3000 — those
#   addresses are unreachable inside a Render container and will cause
#   ECONNREFUSED / AggregateError on every WhatsApp API call.
#
# Example (WAHA deployed as a separate Render service):
#   WAHA_URL=https://waha-nepal-jersey.onrender.com
#
# Example (WAHA deployed on a VPS):
#   WAHA_URL=https://waha.yourdomain.com
#
WAHA_URL=https://your-waha-service.onrender.com
WAHA_SESSION=default
# Set to the API key you configured in WAHA (leave blank if WAHA has no auth)
WAHA_API_KEY=

# ─── Email (optional — Nodemailer) ───────────────────────────────────────────
EMAIL=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
